# =====================================================================
# 1. Configuración de Modelos de Lenguaje (LLMs) & Agentes Cognitivos
# =====================================================================
LLM_PROVIDER=gemini   # Opciones: gemini | openai | anthropic
LLM_TEMPERATURE=0.0   # Inferencia determinista para scoring 0-6 y formato estricto
LLM_MAX_RETRIES=3     # Reintentos automáticos ante cuota o red (exponential backoff)

# Google Gemini (se declaran ambas variables para compatibilidad con PydanticAI y LangGraph)
GEMINI_API_KEY=tu_api_key_de_gemini
GOOGLE_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.6-flash

# OpenAI
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=tu_api_key_de_claude
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# =====================================================================
# 2. Ingesta, Webhooks & Servicios API (FastAPI / n8n)
# =====================================================================
COMMUNITYLAB_WEBHOOK_SECRET=secreto_seguro_equipo34
WEBHOOK_MAX_ITEMS=100
API_HOST=0.0.0.0
API_PORT=8000

# =====================================================================
# 3. Persistencia Local & Curaduría (SQLite & Streamlit)
# =====================================================================
SQLITE_DB_PATH=data/communitylab.db
STREAMLIT_PORT=8501

# =====================================================================
# 4. Oracle Cloud Infrastructure (OCI Always Free - Object Storage)
# =====================================================================
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=mx-queretaro-1
OCI_KEY_FILE=./secrets/communitylab-app-user-oci-api-key.pem
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaaxxxxxxx
OCI_BUCKET_NAME=communitylab-activos-marketing
OCI_NAMESPACE=axxxxxxxxxx
OCI_RUN_TEST_ON_INIT=false   # Cambiar a true para verificar conectividad con OCI al arrancar

# =====================================================================
# 5. Observabilidad & Trazabilidad (structlog)
# =====================================================================
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
